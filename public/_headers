# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# `npm run preview` applies this file the way Pages does; `npm run verify:export` checks it.
#
# Content-Security-Policy: everything comes from this origin. Next.js inlines its RSC payload
# as inline scripts and a static export has no per-request nonce, so script-src keeps
# 'unsafe-inline' (the Next.js guide's static recommendation). style-src needs it for the
# inline CSS variables.
#
# The one third-party source is Cloudflare Web Analytics. Pages injects its beacon as
# https://static.cloudflareinsights.com/beacon.min.js/v<version> with SRI. script-src allows
# that path only, not the whole host. The beacon reports to /cdn-cgi/rum on this origin, so
# connect-src stays 'self'. Nothing else from another origin is allowed
# (scripts/lib/csp.mjs, checked by verify:export and the tests).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed build assets never change — cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand derivatives, photo derivatives and the share image keep their names when
# regenerated, so they revalidate daily.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Only https://latansajogja.co.id is indexed. The project's *.pages.dev copies (the production
# alias and every preview) send noindex: Cloudflare's documented pattern, which covers
# *.pages.dev and *.*.pages.dev without naming the project.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
